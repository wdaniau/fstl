<?xml version='1.0' encoding='UTF-8'?>
<component type="desktop">
    <id>io.github.wdaniau.fstl</id>
    <launchable type="desktop-id">fstlapp-fstl-e.desktop</launchable>
    <name>fstl-e</name>
    <summary>Fast stl viewer</summary>
    <developer id="io.github.wdaniau">
        <name>William Daniau</name>
    </developer>
    <url type="homepage">https://github.com/wdaniau/fstl</url>

    <metadata_license>MIT</metadata_license>
    <project_license>MIT</project_license>
    <content_rating type="oars-1.1" />
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
    </recommends>

    <branding>
      <color type="primary" scheme_preference="light">#3c7ea1</color>
      <color type="primary" scheme_preference="dark">#3c7ea1</color>
    </branding>

    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/wdaniau/fstl/1a533a4bd93a16820d1f26dca1af18fd5a86c085/images/benchy_light_source_position.png</image>
            <caption>Changing shader light source position</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/wdaniau/fstl/1a533a4bd93a16820d1f26dca1af18fd5a86c085/images/benchy_wire.png</image>
            <caption>Adding wireframe on shader</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/wdaniau/fstl/4eb6b0a957eded6bed9ab9f45896cdd1646007a6/images/benchy_doc_1024.png</image>
            <caption>Interface panorama</caption>
        </screenshot>
    </screenshots>
    <description>
        <p>
        fstl-e is a fast, easy to use stl file viewer.
        It is a fork of fstl with some fancy enhancements.
        </p>
    </description>
    <releases>
        <release version="1.2.0" date="2025-11-18">
            <url>https://github.com/wdaniau/fstl/releases/tag/fstl-e-v1.2.0</url>
            <description>
                <ul>
                    <li>Add configurable background (new feature by andreasbkrueger)</li>
                    <li>Minor bug correction</li>
                </ul>
            </description>
        </release>
        <release version="1.1.0" date="2025-02-01">
            <url>https://github.com/wdaniau/fstl/releases/tag/fstl-e-v1.1.0</url>
            <description>
                <ul>
                <li>Add statusbar with statustip and current file name which can be used to drop the current file to another application like a slicer.</li>
                <li>Add anti-aliasing functionality</li>
                <li>Add a menu to choose default rotation between 3 models.</li>
                <li>Add action to recenter the view.</li>
                <li>Add menu to choose between predefined views.</li>
                <li>Add new predefined size HD1080 in viewport size menu.</li>
                <li>Add popup slider to adjust mouse speed movement.</li>
                <li>When using open menu, use most recent file's directory.</li>
                <li>On the command line, can now open a directory.</li>
                <li>In shader preferences, add a new way of choosing light source position.</li>
                </ul>
            </description>
        </release>
        <release version="1.0.0" date="2025-01-09">

        </release>

    </releases>
</component>
